# Local development only. Never put real secrets in this file or Git.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-only-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: leave unset to use local SQLite, or set a PostgreSQL URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Use the same Google OAuth Web client ID in the frontend and API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
# Founder email is fail-closed: leave blank locally unless testing founder-only controls.
FURSA_FOUNDER_EMAIL=
